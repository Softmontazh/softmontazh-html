# Софтмонтаж — каталог Barlau. Ставится deploy/catalog-install.sh в /etc/cron.d/softmontazh-catalog. Время — UTC.
SHELL=/bin/bash
PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
# загрузка из Barlau каждые 6 часов (в 17 минут — не совпадает с задачами платформы)
17 */6 * * * softmontazh nice -n 10 /usr/local/bin/softmontazh-manage import_barlau > /opt/softmontazh/import-last.log 2>&1
# кнопка «Обновить из Barlau сейчас» в админке — проверка каждые 10 минут
*/10 * * * * softmontazh nice -n 10 /usr/local/bin/softmontazh-manage import_barlau --if-requested >> /opt/softmontazh/import-last.log 2>&1
# ночной бэкап базы каталога, храним 7 штук
40 22 * * * softmontazh pg_dump -Fc softmontazh > /opt/softmontazh/backups/catalog-$(date +\%F).dump && ls -1t /opt/softmontazh/backups/catalog-*.dump | tail -n +8 | xargs -r rm -f
